# SENTINEL - Configuración de Entorno (Plantilla Segura)
# Copia este archivo a .env y completa tus credenciales.

# Servidor Backend
PORT=3001
NODE_ENV=development

# Base de Datos (SQLite local por defecto / PostgreSQL opcional)
DB_DRIVER=sqlite
DB_FILE=sentinel.sqlite3
# Para PostgreSQL:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=sentinel
# DB_USER=postgres
# DB_PASSWORD=tu_password

# Seguridad & Autenticación
JWT_SECRET=reemplazar_con_un_jwt_secret_aleatorio_de_minimo_32_caracteres
CORS_ORIGIN=http://localhost:5173

# Have I Been Pwned API (Monitoreo de Filtraciones)
# Obtén tu clave en: https://haveibeenpwned.com/API/v3
HIBP_API_KEY=
HIBP_BASE_URL=https://haveibeenpwned.com/api/v3

# xonPlus / Dark Web Intelligence (Opcional / Fase 3)
XONPLUS_API_KEY=

# Firebase Admin SDK (Para Auth / Firestore / FCM Notificaciones)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
